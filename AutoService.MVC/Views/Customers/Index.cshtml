@model AutoService.MVC.Models.CustomerPageViewModel

@{
    ViewData["Title"] = "Customers";
}

<div class="container mt-4">
    <h2>Customers</h2>

    <a asp-action="Create" class="btn btn-success mb-3">
        + Add Customer
    </a>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <form asp-action="Index" method="get" class="mb-3">
        <input name="search" value="@Model.Search"
               placeholder="Search customer..."
               class="form-control mb-2" />

        <button class="btn btn-primary">Search</button>
    </form>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model.Items)
            {
                <tr>
                    <td>@customer.Id</td>
                    <td>@customer.FirstName @customer.LastName</td>
                    <td>@customer.Email</td>
                    <td>@customer.PhoneNumber</td>
                    <td>
                        <a asp-action="Edit"
                               asp-route-id="@customer.Id"
                               class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@customer.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Delete customer?')">

                            @Html.AntiForgeryToken()

                            <button class="btn btn-danger btn-sm">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Page > 1)
    {
        <a asp-action="Index"
               asp-route-search="@Model.Search"
               asp-route-page="@(Model.Page - 1)"
               class="btn btn-outline-primary">
            Previous
        </a>
    }

    @if (Model.Page < Model.TotalPages)
    {
        <a asp-action="Index"
               asp-route-search="@Model.Search"
               asp-route-page="@(Model.Page + 1)"
               class="btn btn-outline-primary">
            Next
        </a>
    }

    <a asp-controller="Dashboard" asp-action="Admin"
           class="btn btn-secondary">
        Back
    </a>
</div>
