@model AutoService.MVC.Models.RepairOrderPageViewModel
@{
    ViewData["Title"] = "Repair Orders";
    string role = ViewBag.Role as string ?? "";
}
<div class="container mt-4">
    <h2>Repair Orders</h2>
    @if (role == "Admin")
    {
        <a asp-action="Create" class="btn btn-success mb-3">+ Add Order</a>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="get" asp-action="Index" class="mb-3">
        <input class="form-control mb-2" name="search" value="@Model.Search"
               placeholder="Search orders" />
        <button class="btn btn-primary">Search</button>
    </form>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Car ID</th>
                <th>Repair</th>
                <th>Status</th>
                <th>Mechanic ID</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var order in Model.Items)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.CarId</td>
                <td>@order.Description</td>
                <td>@order.Status</td>
                <td>@order.AssignedMechanicUserId</td>
                <td>
                    <form asp-action="ChangeStatus" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@order.Id" />
                        <select name="status" class="form-select form-select-sm mb-1">
                            <option value="Pending">Pending</option>
                            <option value="InProgress">In progress</option>
                            <option value="Completed">Completed</option>
                        </select>
                        <button class="btn btn-primary btn-sm">Change status</button>
                    </form>
                    @if (role == "Admin")
                    {
                        <a asp-action="Edit" asp-route-id="@order.Id"
                           class="btn btn-warning btn-sm">Edit</a>
                        <form asp-action="Assign" method="post" class="mt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@order.Id" />
                            <input type="number" min="1" name="mechanicUserId"
                                   placeholder="Mechanic user ID" required
                                   class="form-control form-control-sm mb-1" />
                            <button class="btn btn-outline-primary btn-sm">Assign</button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@order.Id" method="post"
                              class="mt-2" onsubmit="return confirm('Delete order?')">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if (!Model.Items.Any())
    {
        <p>No repair orders found.</p>
    }
    @if (Model.Page > 1)
    {
        <a asp-action="Index" asp-route-page="@(Model.Page - 1)"
           asp-route-search="@Model.Search" class="btn btn-outline-primary">Previous</a>
    }
    @if (Model.Page < Model.TotalPages)
    {
        <a asp-action="Index" asp-route-page="@(Model.Page + 1)"
           asp-route-search="@Model.Search" class="btn btn-outline-primary">Next</a>
    }

    <a asp-controller="Dashboard" asp-action="@(role == "Admin" ? "Admin" : "Mechanic")"
       class="btn btn-secondary mt-2">Back</a>
</div>
