@model AutoService.MVC.Models.MyAccountViewModel
@{
    ViewData["Title"] = "My Account";
}
<div class="container mt-4">
    <h2>My Cars</h2>
    <table class="table table-striped">
        <thead>
            <tr><th>Car</th><th>Year</th><th>Plate</th><th>Next service</th></tr>
        </thead>
        <tbody>
        @foreach (var car in Model.Cars)
        {
            <tr>
                <td>@car.Brand @car.Model</td>
                <td>@car.Year</td>
                <td>@car.LicensePlate</td>
                <td>@car.NextServiceDate?.ToString("yyyy-MM-dd")</td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Cars.Any()) { <p>No cars registered yet.</p> }

    <h2 class="mt-4">My Repairs</h2>
    <table class="table table-striped">
        <thead>
            <tr><th>Order</th><th>Car ID</th><th>Description</th><th>Status</th><th>Invoice</th></tr>
        </thead>
        <tbody>
        @foreach (var order in Model.Orders)
        {
            <tr>
                <td>#@order.Id</td>
                <td>@order.CarId</td>
                <td>@order.Description</td>
                <td>@order.Status</td>
                <td><a asp-action="Invoice" asp-route-id="@order.Id"
                       class="btn btn-outline-primary btn-sm">View Invoice</a></td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Orders.Any()) { <p>No repairs yet.</p> }

    <h2 class="mt-4">Notifications</h2>
    @foreach (var notification in Model.Notifications)
    {
        <div class="alert alert-info">
            @notification.Message
            <small class="d-block">@notification.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
        </div>
    }
    @if (!Model.Notifications.Any()) { <p>No notifications yet.</p> }

    <a asp-controller="Dashboard" asp-action="Customer" class="btn btn-secondary">Back</a>
</div>
